#define VERSION_NUMBER @GOLD_VERSION_MAJOR@,@GOLD_VERSION_MINOR@,@GOLD_VERSION_REVISION@,0
#define VERSION_NUMBER_STR "@GOLD_VERSION@"

#include <winuser.h>

VLC_ICON ICON "vlc.ico"

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Oliver Bacon"
      VALUE "ProductName", "VLC Gold"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "vlc"
      VALUE "OriginalFilename", "vlc.exe"
      VALUE "FileVersion", "@GOLD_VERSION@"
      VALUE "FileDescription", "VLC Gold"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
